# Genotek AI Lead Generation Platform
# Environment Variables Template
# 
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ============================================
# API KEYS (Required)
# ============================================

# SerperDev API Key
# Get yours at: https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here

# Groq API Key
# Get yours at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# APPLICATION SETTINGS
# ============================================

# Node Environment
NODE_ENV=development

# Server Port
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5000

# ============================================
# DATABASE (Optional - if you add database later)
# ============================================

# DATABASE_URL=postgresql://user:password@localhost:5432/genotek
# DATABASE_POOL_SIZE=10

# ============================================
# MONITORING & LOGGING
# ============================================

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable file logging
LOG_TO_FILE=false

# ============================================
# RATE LIMITING
# ============================================

# API rate limit (requests per minute)
API_RATE_LIMIT=60

# Search delay between requests (seconds)
SEARCH_DELAY=1

# ============================================
# FEATURE FLAGS
# ============================================

# Enable real-time monitoring
ENABLE_AUTO_MONITOR=true

# Enable email notifications (future feature)
ENABLE_EMAIL_NOTIFICATIONS=false

# ============================================
# NOTES
# ============================================

# 1. Copy this file to .env in the root directory
# 2. Fill in your actual API keys and values
# 3. Never commit .env to version control
# 4. Keep your API keys secure and private
# 5. Restart the application after changing values
